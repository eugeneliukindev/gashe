# Integration tests in Docker. Flags go to go test: `just redis test valkey -run Lock`.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

# Run the tests against redis or valkey.
test server="redis" *flags: work
    docker compose up -d --wait {{ server }}
    GASHE_REDIS_ADDR=$(docker compose port {{ server }} 6379) go test -race -count=1 "${@:2}" ./...

# Run the Cluster tests against three masters.
cluster *flags: work
    docker compose up -d --wait cluster
    GASHE_REDIS_CLUSTER=127.0.0.1:17000,127.0.0.1:17001,127.0.0.1:17002 go test -race -count=1 -run Cluster "$@" ./...

# Run the tests against Redis and Valkey at once.
[parallel]
all: (test "redis") (test "valkey")

# Stop the servers.
down:
    docker compose down

# Build against the local gashe code.
[private]
work:
    just --justfile {{ justfile() }} work
